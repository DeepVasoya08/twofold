{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcafold",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Production is served only at its custom domain (added in the dashboard, docs/deployment.md),
  // never at a workers.dev address, which would be a second origin outside the zone's HTTPS
  // and security settings. Staging turns it back on below.
  "workers_dev": false,
  // Keep the Worker's own console logs (which never include keys, tokens or ids), but no
  // per-request logs or traces: those would store every request's path, headers and client
  // details at Cloudflare, which could link a private space's requests to the main
  // library's for as long as they're kept. See docs/security.md.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false },
  },
  // One Worker serves the whole app on one origin: the built web app as static assets,
  // and the API under /api. Build apps/web first (pnpm build does this).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // /api/* always reaches the Worker code. Other paths are served from assets when a file
    // matches (the prerendered landing and legal pages among them), and otherwise reach the
    // Worker, which answers app paths with the app shell (src/index.ts).
    "run_worker_first": ["/api/*"],
  },
  "r2_buckets": [
    {
      // Encrypted blobs only. Object keys are random IDs, never filenames.
      "binding": "BLOBS",
      "bucket_name": "arcafold-blobs",
    },
  ],
  // Account email (codes, sign-in notices) through Cloudflare Email Service, only ever from
  // the no-reply address. Email works once EMAIL_CODE_SECRET is set as a Worker secret
  // (deploy.yml does it from the GitHub secret); see docs/email.md.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@arcafold.com"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arcafold",
      // Replaced at deploy time from the D1_DATABASE_ID repository variable (see deploy.yml).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    // A separate copy for restore drills and trying changes before production
    // (docs/staging.md). It shares nothing with production: its own Worker, database and
    // bucket. Bindings aren't inherited, so both are listed again.
    "staging": {
      "name": "arcafold-staging",
      // Staging has no custom domain: it's served at its workers.dev address (docs/staging.md).
      "workers_dev": true,
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "arcafold-staging-blobs" }],
      // Staging has no EMAIL_CODE_SECRET, so it never sends email or asks to confirm one.
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@arcafold.com"] }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arcafold-staging",
          // Replaced at deploy time with the ID deploy-staging.yml looks up (or creates).
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
