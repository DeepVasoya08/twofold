{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twofold",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // One Worker serves the whole app on one origin: the built web app as static assets,
  // and the API under /api. Build apps/web first (pnpm build does this).
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker code; everything else is served from assets.
    "run_worker_first": ["/api/*"],
  },
  "r2_buckets": [
    {
      // Encrypted blobs only. Object keys are random IDs, never filenames.
      "binding": "BLOBS",
      "bucket_name": "twofold-blobs",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twofold",
      // Replaced at deploy time from the D1_DATABASE_ID repository variable (see deploy.yml).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
