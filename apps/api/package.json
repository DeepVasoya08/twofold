{
  "name": "@arcafold/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "backup": "node --experimental-transform-types --no-warnings --import ./scripts/register.mjs scripts/backup.ts",
    "drill": "node --experimental-transform-types --no-warnings --import ./scripts/register.mjs scripts/drill.ts"
  },
  "dependencies": {
    "@arcafold/crypto": "workspace:*",
    "@arcafold/types": "workspace:*",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@arcafold/web": "workspace:*",
    "wrangler": "^4.156.2"
  }
}
